---
import type { HTMLAttributes } from 'astro/types';
import { type VariantProps, tv } from 'tailwind-variants';

// For a dropdown menu component, we only need list and container elements
// 'ul' is the default for semantic menu lists, 'ol' for ordered lists,
// and 'div' for custom dropdown containers
type ElementTag = 'ul' | 'ol' | 'div';

type PropsForElement<E extends ElementTag> = VariantProps<
  typeof dropdownContent
> &
  HTMLAttributes<E> & { as: E };

type Props =
  | PropsForElement<Exclude<ElementTag, 'ul'>>
  | (VariantProps<typeof dropdownContent> &
      HTMLAttributes<'ul'> & { as?: 'ul' });

const {
  as: Tag = 'ul',
  placement,
  alignment,
  class: className,
  ...rest
} = Astro.props;
export const dropdownContent = tv({
  base: 'dropdown menu w-52 rounded-box bg-base-100 shadow-sm',
  variants: {
    placement: {
      top: 'dropdown-top',
      bottom: 'dropdown-bottom',
      left: 'dropdown-left',
      right: 'dropdown-right',
    },
    alignment: {
      start: 'dropdown-start',
      center: 'dropdown-center',
      end: 'dropdown-end',
    },
  },
  defaultVariants: {
    placement: 'bottom',
    alignment: 'center',
  },
});
---

<Tag
  data-dropdown-part="content"
  class={dropdownContent({ placement, alignment, class: className })}
  {...rest}
>
  <slot />
</Tag>
